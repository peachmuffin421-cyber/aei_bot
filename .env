# ============================================================================
# ÆI SEED TWA — ENVIRONMENT TEMPLATE (ed40 ultimate-safe-frac)
# Web dyno binds $PORT directly via ThreadingHTTPServer(0.0.0.0, $PORT)
# No tunnel, no subprocess. Graceful SIGTERM via Event.wait(1.0)
# Copy to .env and fill. NEVER commit filled .env
# Heroku: heroku config:set KEY=value
# ============================================================================

# REQUIRED — TELEGRAM
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=https://peachmuffin421-cyber.github.io/aeindex/

# PORT / BRIDGE — web dyno substrate
# Heroku assigns $PORT, app.py binds it directly. BRIDGE_PORT is local fallback.
PORT=
BRIDGE_PORT=8765
BRIDGE_HOST=0.0.0.0
BRIDGE_USE_TLS=0
BRIDGE_TLS_CERT=
BRIDGE_TLS_KEY=
BRIDGE_PUBLIC_TIMEOUT=45

# CRAWLER RELAY — Cloudflare Worker stateless fetch proxy
RELAY_URL=https://aei-seed-relay.<sub>.workers.dev
RELAY_KEY=
RELAY_TIMEOUT=15
RELAY_MAX_RETRIES=3

# CRAWLER STATE
CRAWLER_DB_PATH=aei_crawler.db
CRAWL_SEED_URLS=
CRAWLER_BLOCKLIST=meta.wikimedia.org,wikimedia.org/w/api,thumb.wikimedia.org,upload.wikimedia.org,featuredfeed
CRAWL_INTERVAL=3
MAX_CRAWL_DEPTH=3

# SEED LOOP
SEED_TICK_INTERVAL=5

# AUTH & LOGGING
REQUIRE_AUTH=1
CORS_ORIGIN=*
LOG_BUFFER_SIZE=1000
TOAST_BUFFER_SIZE=500

# GATE
ALLOWED_USER_IDS=

# TELEGRAM AS DATABASE — durable storage via Telegram Bot API (outbound HTTPS only)
# All Fractions stored as str(num/den) — exactness preserved. Chunked to 3800 chars (Telegram limit 4096)
ENABLE_TELEGRAM_DB=1
TELEGRAM_DB_CHANNEL_ID=-1001234567890
TELEGRAM_DB_CENTRAL_USER_ID=123456789
TELEGRAM_DB_USER_SHARDS=1
TELEGRAM_DB_SHARD_POOL=123456789,987654321
TELEGRAM_DB_SAVE_INTERVAL=5
TELEGRAM_DB_CHUNK_SIZE=3800
TELEGRAM_DB_PIN_INDEX=0

# OPTIONAL — Heroku introspection
HEROKU_APP_NAME=
HEROKU_APP_DEFAULT_DOMAIN_NAME=
