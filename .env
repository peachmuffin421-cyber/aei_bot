# ============================================================================
# ÆI SEED TELEGRAM BOT — ENVIRONMENT TEMPLATE
# Version: vFinal (Audit-Patched Edition 3)
# ============================================================================
# Copy to `.env` and fill in real values. NEVER commit the filled `.env`.
#
#   cp .env.example .env
#   $EDITOR .env
#
# Heroku: set each var via `heroku config:set KEY=value -a your-app-name`
#         (the `.env` file is ignored by Heroku; it is for local runs only).
#
# Termux / local shell: `set -a; . ./.env; set +a` before `python3 app.py`.
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED — TELEGRAM
# ----------------------------------------------------------------------------
# Bot token from @BotFather. Also used to derive the WebApp initData HMAC
# secret key (HMAC_SHA256(bot_token, "WebAppData")).
TELEGRAM_BOT_TOKEN=

# ----------------------------------------------------------------------------
# REQUIRED FOR MINI APP — PUBLIC HTTPS ENDPOINT
# ----------------------------------------------------------------------------
# If set, the tunnel manager refuses to spawn cloudflared/ngrok/serveo and
# uses this URL verbatim. Must be HTTPS; Telegram rejects cleartext.
#
# Examples:
#   Local tunnel mode:  leave empty (auto-spawned *.trycloudflare.com)
#   Split-origin mode:  https://<user>.github.io/<repo>/
#   Reverse-proxy mode: https://your-domain.example/aei
TELEGRAM_WEBAPP_URL=

# ----------------------------------------------------------------------------
# REQUIRED FOR CRAWLER — CLOUDFLARE WORKER RELAY
# ----------------------------------------------------------------------------
# Public URL of the deployed Worker (see the aei-seed-relay repo).
# Example: https://aei-seed-relay.<your-subdomain>.workers.dev
#
# The Worker is a STATELESS fetch proxy: given a URL, it fetches the page,
# extracts the <title>, the content hash, and the outbound links, and
# returns the result as JSON. It does NOT dispatch to Kraken, Stooq,
# Binance, CoinGecko, or Yahoo. It does NOT hold the crawl frontier. It
# does NOT classify symbols. All crawl logic (frontier, visited set,
# depth limits, hash lifting to exact Fraction, symbolic-input injection
# into AEI_Seed.step) lives in app.py.
RELAY_URL=

# Optional shared secret enforced by the Worker via X-Relay-Key.
# If the Worker is deployed without a secret check, leave empty.
RELAY_KEY=

# Relay HTTP client tuning.
RELAY_TIMEOUT=15
RELAY_MAX_RETRIES=3

# ----------------------------------------------------------------------------
# BRIDGE — LOCAL HTTP SERVER
# ----------------------------------------------------------------------------
# Heroku assigns $PORT dynamically; app.py prefers $PORT over $BRIDGE_PORT.
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8765

# TLS on the local bridge (Heroku terminates TLS at its router → leave 0).
BRIDGE_USE_TLS=0
BRIDGE_TLS_CERT=
BRIDGE_TLS_KEY=

# Tunnel preference order: cloudflared | ngrok | serveo
BRIDGE_TUNNEL=cloudflared
BRIDGE_PUBLIC_TIMEOUT=45

# ----------------------------------------------------------------------------
# AUTH & LOGGING
# ----------------------------------------------------------------------------
# Enforce X-Telegram-Init-Data on all non-/health endpoints.
# Set to 0 ONLY for local development without a Telegram WebView.
REQUIRE_AUTH=1

# Ring-buffer size for the /log endpoint.
LOG_BUFFER_SIZE=1000

# Ring-buffer size for the /toasts endpoint.
TOAST_BUFFER_SIZE=500

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
# "*" permits any origin. Lock down to your GitHub Pages origin in production:
#   CORS_ORIGIN=https://<user>.github.io
CORS_ORIGIN=*

# ----------------------------------------------------------------------------
# SEED LOOP
# ----------------------------------------------------------------------------
# Interval between seed steps (seconds). The seed's step function is
# Fraction-exact; each step generates the next prime, projects it onto the
# lattice, validates s²=r², applies DbZ if needed, and records the
# intelligence metric.
SEED_TICK_INTERVAL=5

# ----------------------------------------------------------------------------
# CRAWLER
# ----------------------------------------------------------------------------
# Interval between crawl attempts (seconds).
CRAWL_INTERVAL=3

# Maximum crawl recursion depth. Links from a document at depth D are
# enqueued at depth D+1 if D < MAX_CRAWL_DEPTH.
MAX_CRAWL_DEPTH=3

# Comma-separated seed URLs. Overrides the default 7 (Wikipedia pages for
# Riemann hypothesis, Leech lattice, Hopf fibration, prime numbers,
# quaternions, continued fractions, Chinese remainder theorem).
#
# Leave empty to use the default set.
CRAWL_SEED_URLS=

# SQLite DB path for frontier + visited. ":memory:" for ephemeral,
# a file path for persistence across restarts.
CRAWLER_DB_PATH=aei_crawler.db

# ----------------------------------------------------------------------------
# USER ALLOWLIST
# ----------------------------------------------------------------------------
# Comma-separated Telegram user IDs. Empty = open bot (legacy behavior).
# For a private deployment, put your own user ID (from /whoami).
# Example: ALLOWED_USER_IDS=8769538718
ALLOWED_USER_IDS=