# ============================================================================
# Æ TWA — FUSED BACKEND — ENVIRONMENT TEMPLATE
# Version: Final, First edition
# ============================================================================
# Copy to `.env` and fill in real values. NEVER commit the filled `.env`.
#
#   cp .env.example .env
#   $EDITOR .env
#
# Heroku: heroku config:set KEY=value -a your-app-name
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED — TELEGRAM
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# ----------------------------------------------------------------------------
# REQUIRED FOR MINI APP — PUBLIC HTTPS ENDPOINT
# ----------------------------------------------------------------------------
# GitHub Pages URL of the fused TWA (index.html).
TELEGRAM_WEBAPP_URL=https://<user>.github.io/aeindex/

# ----------------------------------------------------------------------------
# REQUIRED FOR MARKET AND CRAWLER — CLOUDFLARE WORKER RELAY
# ----------------------------------------------------------------------------
# Public URL of the deployed fused Worker. It serves BOTH routes:
#   - GET /?url=<https-url>     (crawler fetch)
#   - GET /?symbol=<S>&kind=<price|volume|intraday|history|candles>
#                                (market data: Kraken→Stooq→Binance→CoinGecko→Yahoo)
RELAY_URL=https://aei-relay.<your-subdomain>.workers.dev

# Optional shared secret. If set, must match `wrangler secret put RELAY_KEY`.
RELAY_KEY=

# Relay HTTP client tuning.
RELAY_TIMEOUT=15
RELAY_MAX_RETRIES=3

# ----------------------------------------------------------------------------
# BRIDGE — LOCAL / HEROKU HTTP SERVER
# ----------------------------------------------------------------------------
# Heroku assigns $PORT dynamically; app.py prefers $PORT over $BRIDGE_PORT.
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8765

# TLS on the local bridge (Heroku terminates TLS at its router → leave 0).
BRIDGE_USE_TLS=0
BRIDGE_TLS_CERT=
BRIDGE_TLS_KEY=

# ----------------------------------------------------------------------------
# AUTH & LOGGING
# ----------------------------------------------------------------------------
# Enforce X-Telegram-Init-Data on all non-/health endpoints.
# Set to 0 ONLY for local development without a Telegram WebView.
REQUIRE_AUTH=1

# Ring buffer sizes.
LOG_BUFFER_SIZE=1000
TOAST_BUFFER_SIZE=500

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
# "*" permits any origin. Lock down to your GitHub Pages origin in production.
CORS_ORIGIN=*

# ----------------------------------------------------------------------------
# ENGINE — DEFAULT SYMBOL & TIMEFRAME
# ----------------------------------------------------------------------------
SYMBOL=BTC/USD
TIMEFRAME=M15

# ----------------------------------------------------------------------------
# ENGINE — LOOP INTERVALS
# ----------------------------------------------------------------------------
SEED_TICK_INTERVAL=5
CRAWL_INTERVAL=3
MAX_CRAWL_DEPTH=3

# ----------------------------------------------------------------------------
# GATE
# ----------------------------------------------------------------------------
ALLOWED_USER_IDS=